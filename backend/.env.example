# Database
DATABASE_URL="postgresql://user:password@localhost:5432/agri_risk_db"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# External APIs
WEATHER_API_KEY=your-weather-api-key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# Satellite Data (Sentinel Hub or similar)
SATELLITE_API_KEY=your-satellite-api-key
SATELLITE_API_URL=https://services.sentinel-hub.com/api/v1

# Agri Stack
AGRI_STACK_API_KEY=your-agri-stack-api-key
AGRI_STACK_API_URL=https://api.agristack.gov.in

# Market Price API
MARKET_API_KEY=your-market-api-key
MARKET_API_URL=https://api.data.gov.in/resource

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Pest Advisory
PEST_API_URL=https://icar.gov.in/api/pest-advisory

# Alerts
ALERT_SMS_API_KEY=your-sms-api-key
ALERT_SMS_API_URL=https://api.textlocal.in/send
ALERT_WHATSAPP_API_KEY=your-whatsapp-api-key

# Cron Schedule (Daily at 6 AM)
RISK_CRON_SCHEDULE="0 6 * * *"

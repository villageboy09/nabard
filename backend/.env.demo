# Demo Mode Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_risk_demo"
PORT=5000
NODE_ENV=development

# Demo Mode
DEMO_MODE=true

# JWT Configuration
JWT_SECRET=demo-secret-key-for-testing-only
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# External API Keys (not required in demo mode - mock data will be used)
WEATHER_API_KEY=demo-key
GEMINI_API_KEY=demo-key
SATELLITE_API_KEY=demo-key
AGRI_STACK_API_KEY=demo-key
MARKET_API_KEY=demo-key

# Cron Schedule (every 6 hours for demo)
RISK_CRON_SCHEDULE="0 */6 * * *"

# Alert Configuration
ALERT_SMS_API_KEY=demo-key
ALERT_SMS_API_URL=https://demo.api/sms

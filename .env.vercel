# Vercel Environment Variables

# Database (Use Vercel Postgres or external PostgreSQL)
DATABASE_URL="postgresql://user:password@your-postgres-host/agri_risk_db"
POSTGRES_PRISMA_URL="postgresql://user:password@your-postgres-host/agri_risk_db"
POSTGRES_URL_NON_POOLING="postgresql://user:password@your-postgres-host/agri_risk_db"

# JWT
JWT_SECRET="your-production-secret-key-here"
JWT_EXPIRES_IN="7d"

# Demo Mode
DEMO_MODE="true"

# Node Environment
NODE_ENV="production"

# API Keys (Optional - not required for demo mode)
WEATHER_API_KEY="your-weather-api-key"
GEMINI_API_KEY="your-gemini-api-key"
SATELLITE_API_KEY="your-satellite-api-key"
AGRI_STACK_API_KEY="your-agri-stack-api-key"
